{
  "name": "solum-terrain-studio",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "A local-first Windows terrain authoring studio for Roblox developers.",
  "author": "Matei Renn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateirenn/solum.git"
  },
  "homepage": "https://github.com/mateirenn/solum",
  "bugs": {
    "url": "https://github.com/mateirenn/solum/issues"
  },
  "keywords": [
    "roblox",
    "terrain",
    "heightmap",
    "world-building",
    "tauri",
    "windows"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "pixi.js": "^8.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^7.0.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
